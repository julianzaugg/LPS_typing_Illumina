// Container engine profiles. Select one with -profile singularity or -profile apptainer.
// Combine with -profile slurm for SLURM cluster execution, e.g. -profile apptainer,slurm
profiles {
	singularity {
		singularity.enabled = true
		singularity.cacheDir = "./singularity"
		singularity.runOptions = "--no-home"
		singularity.autoMounts = true
	}

	apptainer {
		apptainer.enabled = true
		apptainer.cacheDir = "./singularity"
		apptainer.runOptions = "--no-home"
		apptainer.autoMounts = true
	}

	slurm {
		process {
			executor = 'slurm'
			clusterOptions = "--account=${params.slurm_account}"
			time = '8h'
		}
	}
}

// ensure that no user libraries get mounted into the container
process.containerOptions = "--no-home"

env {
    PYTHONNOUSERSITE = 1
}

// Default parameters. Commandline parameters will take priority over these
params {
	slurm_account = ''
	outdir = './results'
	datadir = "${projectDir}/databases"
	threads = 4
	skip_fastp = false
	skip_fastqc = false
	skip_summary_fastqc = false
	shovill_args = ""
	//shovill_args = "--minlen 200 --mincov 10"
	shovill_threads = 4
	genome_size = "2.3M"
	skip_quast = false
	quast_threads = 2
	skip_sylph = false
	skip_download_sylph_db = true
	sylph_threads = 6
	sylph_db_gtdb_file = 'http://faust.compbio.cs.cmu.edu/sylph-stuff/gtdb-r232-c200-dbv1.syldb'
	sylph_db_fungal_file = 'http://faust.compbio.cs.cmu.edu/sylph-stuff/fungi-refseq-2025-10-11-c200-dbv1.syldb'
	sylph_tax_gtdb_metadata = 'https://zenodo.org/records/19646381/files/gtdb_r232_metadata.tsv.gz'
	sylph_tax_fungal_metadata = 'https://zenodo.org/records/17330476/files/fungi_refseq_2025-10-11_metadata.tsv.gz'
	sylph_db = "${projectDir}/databases/sylph/*.syldb"
	sylph_metadata = "${projectDir}/databases/sylph/*.tsv.gz"
	skip_checkm = false
	download_checkm_db = false
	checkm_db = "${projectDir}/databases/checkm_data_2015_01_16"
	skip_kaptive3 = false
	kaptive_db_9lps = "${projectDir}/databases/kaptive3_LPS_db_v1/9lps.gbk"
	// Define the LPS reference data. Should contain:
	//   - reference_LPS.txt
	//   - LPS_subtype_database_v2.txt
	//   - petG_X73_NZ_CM001580.fasta
	//   - all FASTA/GB files defined in reference_LPS.txt
	//   - .fai files for each FASTA
	reference_LPS_directory = "${projectDir}/databases/LPS"
	skip_snippy = false
	snippy_args = ""
	snippy_threads = 6
	skip_mlst = false
	mlst_scheme = "pmultocida_2"
	mlst_datadir = ""
	skip_petg = false
	petg_threads = 2
	petg_min_length = 1570
	petg_min_identity = 95
	skip_bakta = false
	bakta_threads = 8
	download_bakta_db = false
	bakta_db = "${projectDir}/databases/bakta/db"
	bakta_args = "--proteins ${projectDir}/databases/trusted_bakta_proteins.fasta"
	skip_amrfinder = false
	download_amrfinder_db = false
	amrfinder_db = "${projectDir}/databases/amrfinderplus/2025-03-25.1"
	amrfinder_args = ""
	skip_html_report = false
}

mounts {
        outdir = "-B \"`[[ \"${params.outdir}\" =~ ^/ ]] && echo ${params.outdir} || echo ${PWD}/${params.outdir}`\""
        datadir = "-B \"`[[ \"${params.datadir}\" =~ ^/ ]] && echo ${params.datadir} || echo ${PWD}/${params.datadir}`\""
}

// Not generally user-modifiable !!!
process {
	withLabel: high_memory { memory = 200.GB }
	withLabel: very_high_memory { memory = 300.GB }
	withName: fastp { container = 'docker://quay.io/biocontainers/fastp:0.24.0--heae3180_1' }
	withName: fastqc { container = 'docker://quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'  }
	withName: summary_fastqc { container = 'docker://quay.io/biocontainers/multiqc:1.28--pyhdfd78af_0' }
	withName: shovill { container = 'docker://quay.io/biocontainers/shovill:1.4.2--hdfd78af_0' }
	withName: checkm { container = 'docker://quay.io/staphb/checkm:1.2.2' }
	withName: sylph { container = 'docker://quay.io/biocontainers/sylph:0.8.1--ha6fb395_0' }
	withName: 'sylph_tax' { container = 'docker://quay.io/biocontainers/sylph-tax:1.3.0--pyhdfd78af_0' }
	withName: 'sylph_tax_download_metadata' { container = 'docker://quay.io/biocontainers/sylph-tax:1.3.0--pyhdfd78af_0' }
	withName: kaptive3 { container = 'docker://quay.io/biocontainers/kaptive:3.0.0b6--pyhdfd78af_0' }
	withName: snippy { container = 'docker://quay.io/staphb/snippy:4.6.0-SC2' }
	withName: quast { container = 'docker://quay.io/biocontainers/quast:5.2.0--py39pl5321h4e691d4_3' }
	withName: mlst { container = 'docker://quay.io/biocontainers/mlst:2.33.1--hdfd78af_0' }
	withName: petg_blast { container = 'docker://quay.io/biocontainers/blast:2.17.0--h66d330f_0' }
	// Custom image pinning diamond 2.2.0 to work around a bakta 1.12.0 segfault
	// (diamond error, exit -11): https://github.com/oschwengers/bakta/issues/445
	// See docker_builds/bakta_1.12.0_diamond_fix/Dockerfile. Revert to the
	// upstream biocontainer once bakta releases an official fix.
	withName: 'bakta' { container = 'docker://ghcr.io/julianzaugg/bakta:1.12.0-diamond220' }
	withName: 'download_bakta_db' { container = 'docker://quay.io/biocontainers/bakta:1.12.0--pyhdfd78af_0' }
	withName: 'amrfinder|download_amrfinder_db' { container = 'docker://quay.io/biocontainers/ncbi-amrfinderplus:4.0.23--hf69ffd2_0' }
	// Custom report image (see containers/report/Dockerfile). Build and push once,
	// then pin the tag here. Pure Python: pandas + matplotlib + jinja2.
	withName: html_report { container = 'docker://ghcr.io/julianzaugg/lps_typing_report:0.1' }
}

// Debug and report options
trace {
  enabled = true
  file = "${params.outdir}/trace.txt"
  overwrite = true
}
timeline {
  enabled = true
  file = "${params.outdir}/timeline.html"
  overwrite = true
}
report {
  enabled = true
  file = "${params.outdir}/report.html"
  overwrite = true
}
dag {
  enabled = true
  file = "${params.outdir}/flowchart_dag.svg"
  overwrite = true
}

manifest {
  name = ''
  author = 'Valentine Murigneux, Julian Zaugg'
  description = 'Pasteurella multocida LPS typing pipeline for Illumina data'
  mainScript = 'main.nf'
  nextflowVersion = '>=25.04.6'
  version = '0.1'
}
